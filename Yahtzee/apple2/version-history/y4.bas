10  TEXT : NORMAL : HOME 
15 SCCOUNT = 13
20  DIM PS(SCCOUNT): REM PLAYER SCORE
21  DIM DESC$(SCCOUNT): REM DESCRIPTION OF ROW SCORE
30  DIM CS(SCCOUNT): REM COMPUTER SCORE
31  DIM SR(SCCOUNT): REM SCORING RUBRIC
32  DIM SS(6): REM SCORING SUM FOR THE SIX FACES - USED BY SCORER (LINE 10000)
33 NOM$ = "BORK": REM  FOR THOSE WHO COME AFTER
34 TN = 1: REM  TURN NUMBER
35 TC = 3: REM  TURN COUNT
36 RN = 1: REM  ROUND NUMBER
37 RC = 13: REM  ROUND COUNT
38  DIM DICE(4): REM DICE
39  DIM KEEPIES(4): REM DICE TO KEEP FOR NEXT TURN 
40 NS =  - 1: REM CONSTANT FOR 'NO SCORE'
41  DIM DS(SCCOUNT): REM SCORES FOR CURRENT DICE FACES
42 DC = 4: REM DICE COUNT
100  GOSUB 11000: REM  DATA AND INITIALIZATION
110  FOR RN = 1 TO RC
112  FOR I = 0 TO DC:KEEPIES(I) = 0: NEXT 
115  GOSUB 8000: REM  ROLL
120  FOR TN = 1 TO TC
125  PRINT 
130  PRINT "ROUND ";RN,"TURN ";TN
150  GOSUB 1000: REM SHOW HAND
160 IR = 99: REM ILLEGAL VALUE
170  GOSUB 6000: REM LINE INPUT
180  IF IR = 1 THEN  GOSUB 8000: GOTO 300: REM ROLL
190  IF IR = 2 THEN  GOTO 150: REM KEEPIES UPDATED. DOESN'T END TURN
200  IF IR = 3 THEN  GOSUB 10000: GOSUB 3000:TN = TC: GOTO 300: REM SCORE DICE, QUERY SCORE, GO TO NEXT ROUND
210  IF TN = 3 THEN  GOSUB 10000: GOSUB 3000: REM  SCORE, QUERY SCORE
300  NEXT TN
400  NEXT RN
950  END 
998  REM ==========
999  REM  DISPLAY DICE AND KEEPIES
1000  PRINT "CURRENT HAND:"
1010  FOR I = 0 TO DC
1020  IF KEEPIES(I) GOTO 1100
1030  REM NON-KEEP
1040  PRINT I;": ";DICE(I)
1090  GOTO 1190
1100  REM KEEP
1110  PRINT I;": ";DICE(I);" ";
1120  INVERSE : PRINT "KEEP": NORMAL 
1190  NEXT 
1500  RETURN 
3000  HOME : NORMAL 
3005  FOR I = 0 TO DC: PRINT DICE(I);", ";: NEXT : PRINT 
3010  PRINT "Scorecard for ";NOM$
3015 SS = 0: REM SCORING SUM, FOR SECTION TOTALS
3017 LS = 0: REM LOWER-SECTION SUM
3020  PRINT "UPPER SECTION ----------"
3030  FOR I = 0 TO 5: REM UPPER SECTION FIELDS
3040  PRINT "("; CHR$(I + 65);") ";DESC$(I);
3050  HTAB 20
3060  IF PS(I) =  - 1 THEN  INVERSE : PRINT "  ";DS(I);"  ": GOTO 3090
3070  PRINT "  ";PS(I);"  "
3080 SS = SS + PS(I)
3090  NORMAL : NEXT 
3100  PRINT "CURRENT UPPER TOTAL: ";SS
3110  IF SS >  = 64 THEN  PRINT "BONUS : 25":SS = SS + 25
3200  REM ----- LOWER SECTION
3205  PRINT : PRINT "LOWER SECTION ------"
3210  FOR I = 6 TO 12
3220  PRINT "("; CHR$(I + 65);") ";DESC$(I);
3230  HTAB 20
3240  IF PS(I) =  - 1 THEN  INVERSE : PRINT "  ";DS(I);"  ": NORMAL : GOTO 3270
3250  PRINT "  ";PS(I);"  "
3260 LS = LS + PS(I)
3270  NEXT 
3275 SS = SS + LS
3280  PRINT "CURRENT LOWER TOTAL: ";LS
3300  PRINT "GRAND TOTAL: ";SS
3400  VTAB 23: HTAB 1
3410  PRINT "SCORE INTO (A-M): ";: GET X$
3420 I =  ASC(X$) - 65
3430  IF I < 0 OR I > 12 THEN  PRINT  CHR$(7);: GOTO 3400
3440  IF PS(I) <  >  - 1 THEN  PRINT  CHR$(7);: GOTO 3400: REM SCORE SLOT ALREADY OCCUPIED
3500 PS(I) = DS(I): REM FINALLY ACTUALLY ADD TO SCORE CARD
3510  RETURN 
5998  REM ==========
5999  REM LINE INPUT / HANDLE ADMINISTRIVIA
6000  PRINT "Command? (r ";RN;" t ";TN;") ";
6010  GET X$
6013  PRINT X$
6015  IF  ASC(X$) = 3 THEN  END : REM ^C
6020  IF X$ = "R" GOTO 6100
6030  IF X$ = "K" GOTO 6200
6040  IF X$ = "S" GOTO 6300
6050  IF X$ = "Q" GOTO 6400
6060  IF X$ = "?" GOTO 6500
6070  IF X$ = "D" GOTO 6600
6080  PRINT "EXPECTED ONE OF RKSQ?D"
6090  GOTO 6000
6100  IF TN < 3 THEN IR = 1: RETURN : REM RE-ROLL
6110  PRINT : PRINT "Cannot re-roll on third turn": PRINT 
6120  GOTO 6000
6200  PRINT 
6205  FOR I = 0 TO DC:KEEPIES(I) = 0: NEXT 
6210  INPUT "KEEP WHICH ONES (e.g.134) ";X$
6220  FOR I = 1 TO  LEN(X$)
6230 K$ =  MID$ (X$,I,1)
6240 K =  ASC(K$) -  ASC("0")
6250 KEEPIES(K) = 1
6260  NEXT 
6270 IR = 2: REM KEEPIES UPDATED
6280  RETURN 
6300 IR = 3: REM USER WANTS TO SCORE
6310  RETURN 
6400  PRINT : PRINT "REALLY QUIT? ";: GET X$: IF X$ = "Y" THEN  END 
6410  PRINT 
6420  GOTO 6000
6500  GOSUB 12000: REM RULES
6510  GOTO 6000
6600  GOSUB 7000: REM DEBUG
6610  GOTO 6000
6998  REM  ====================
6999  REM  DEBUG OUTPUT
7000  PRINT : PRINT "DEBUG INFO(E)"
7005  PRINT "    PLAYER ";NOM$
7010  FOR I = 0 TO SCCOUNT
7019  REM  SCORE NAME, PLAYER, COMPUTER SCORE, RUBRIC, AND CURRENT FACE SCORE
7020  PRINT "  ";DESC$(I);
7022  HTAB 14: IF PS(I) =  - 1 THEN  PRINT "  ";: GOTO 7024
7023  PRINT PS(I);
7024  HTAB 18: PRINT CS(I);
7026  HTAB 22: PRINT DS(I);
7028  HTAB 28: PRINT SR(I);
7029  PRINT 
7030  NEXT 
7040  PRINT "ROUND ";RN;" OF ";RC;"  -  TURN ";TN;" OF ";TC
7050  PRINT "DICE ";: FOR I = 0 TO 4: PRINT DICE(I);" ";: NEXT 
7055  PRINT 
7060  PRINT "KEEP ";: FOR I = 0 TO 4: PRINT KEEPIES(I);" ";: NEXT 
7070  PRINT 
7080  RETURN 
7998  REM ====================
7999  REM ROLL DICE, HONORING KEEPIES
8000  FOR I = 0 TO DC
8010  IF KEEPIES(I) THEN  GOTO 8040
8020 DR =  INT( RND(1) * 6 + 1)
8030 DICE(I) = DR
8040  NEXT 
8050  RETURN 
9998  REM  ==========
9999  REM SCORING. TAKES DICE IN DICE() AND FILLS IN SCORING SHEET IN DS() FOR ALL THE POSSIBLE SCORES
10000  FOR I = 0 TO 5:SS(I) = 0: NEXT 
10010  FOR I = 0 TO SCCOUNT:DS(I) = 0: NEXT 
10020 SHANCE = 0
10100  REM  ----- CALCULATE UPPER SECTION AND CHANCE
10110  FOR I = 0 TO DC
10120 D = DICE(I)
10130 SS(D - 1) = SS(D - 1) + 1
10140 SHANCE = SHANCE + D
10150  NEXT : REM DICE 0...4
10698  REM  ----- FILL OUT SCORING ARRAY FROM ACCUMULATED VALUES
10699  REM --- SCORE TOP SECTION AND CHANCE
10700  FOR I = 0 TO 5:DS(I) = SS(I) * (I + 1): NEXT 
10710 DS(12) = SHANCE
10720  REM ---SCORE 3 AND 4 OF A KIND
10750  FOR I = 0 TO 5
10760  IF SS(I) >  = 3 THEN DS(6) = SHANCE: REM 3 OF A KIND
10770  IF SS(I) >  = 4 THEN DS(7) = SHANCE: REM 4 OF A KIND
10775  NEXT 
10778  REM ----FULL HOUSE: 2 OF ONE AND 3 OF ANOTHER
10780 H2 = 0:H3 = 0: REM HAS 2 OR HAS 3 'BOOLS'
10790  FOR I = 0 TO 5
10800  IF SS(I) = 2 THEN H2 = 1
10810  IF SS(I) = 3 THEN H3 = 1
10814  REM BE PEDANTIC AND ACCEPT 5 OF A KIND AS A FULL HOUSE TOO
10815  IF SS(I) = 5 THEN H2 = 1:H3 = 1
10820  NEXT I
10830  IF H2 AND H3 THEN DS(8) = SR(8)
10839  REM  ---SMOL STRAIGHT. LOOK EXHAUSTIVELY
10840 HS = 0: REM  HAS(SMOL) STRAIGHT
10850  IF SS(0) AND SS(1) AND SS(2) AND SS(3) THEN HS = 1
10855  IF  NOT HS AND SS(1) AND SS(2) AND SS(3) AND SS(4) THEN HS = 1
10900  IF  NOT HS AND SS(2) AND SS(3) AND SS(4) AND SS(5) THEN HS = 1
10910  IF HS THEN DS(9) = SR(9)
10920 HS = 0: REM  RESET AND LOOK FOR LORGE STRAIGHT
10930  IF SS(0) AND SS(1) AND SS(2) AND SS(3) AND SS(4) THEN HS = 1
10935  IF  NOT HS AND SS(1) AND SS(2) AND SS(3) AND SS(4) AND SS(5) THEN HS = 1
10940  IF HS THEN DS(10) = SR(10)
10949  REM  LOOK FOR THE BIG CROWSHAW
10950 HY = 0: REM  HAS YAHTZEE
10960  FOR I = 0 TO 5
10965  IF SS(I) = 5 THEN HY = 1
10970  NEXT 
10980  IF HY THEN DS(11) = SR(11)
10990  RETURN 
10998  REM  ====================
10999  REM  DATA AND INITIALIZATION 
11000  FOR I = 0 TO SCCOUNT
11010  READ DESC$(I)
11020  NEXT 
11050  FOR I = 0 TO SCCOUNT
11060  READ SR(I)
11070  NEXT 
11100  FOR I = 0 TO SCCOUNT
11110 PS(I) = NS: REM NO-SCORE-I
11120 CS(I) = NS
11130  NEXT 
11400  RETURN 
